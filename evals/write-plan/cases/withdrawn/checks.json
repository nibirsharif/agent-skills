{
  "description": "FR-002 is withdrawn and FR-003 is withdrawn and moved to NFR-001. The plan covers FR-001, FR-004, and NFR-001, and puts neither withdrawn ID in a phase.",
  "counts": {
    "phases": {
      "pattern": "^### Phase \\d+",
      "min": 1,
      "max": 2
    },
    "FR-001 once": {
      "pattern": "^\\*\\*Requirements:\\*\\*.*\\bFR-001\\b",
      "min": 1,
      "max": 1
    },
    "FR-004 once": {
      "pattern": "^\\*\\*Requirements:\\*\\*.*\\bFR-004\\b",
      "min": 1,
      "max": 1
    },
    "NFR-001 once": {
      "pattern": "^\\*\\*Requirements:\\*\\*.*\\bNFR-001\\b",
      "min": 1,
      "max": 1
    }
  },
  "must_match": [
    {
      "pattern": "\\A## 1\\. Approach",
      "why": "the reply is the plan alone: it starts at the Approach heading, with no preamble"
    },
    {
      "pattern": "^\\*\\*Requirements:\\*\\*(?=.*\\bFR-001\\b)(?=.*\\bNFR-001\\b)",
      "why": "NFR-001 is a deadline on FR-001: same phase"
    }
  ],
  "must_not_match": [
    {
      "pattern": "^(\\*\\*Requirements:\\*\\*|\\|).*\\bFR-00[23]\\b",
      "why": "withdrawn requirements are not planned"
    },
    {
      "pattern": "^- FR-00[23]:",
      "why": "withdrawn requirements get no verification"
    },
    {
      "pattern": "^## 5\\. Revision History|^---$|^Note:",
      "why": "no Revision History, closing note, or rule in a chat reply"
    }
  ]
}
