      "max": 0
    },
    "size stated": {
      "pattern": "^\\*\\*Size:\\*\\* about \\d+ files",
      "min": 3
    },
    "phase over 10 files": {
      "pattern": "^\\*\\*Size:\\*\\* about (1[1-9]|[2-9]\\d|\\d{3,}) files",
      "max": 0
    },
    "reuse none found": {
      "pattern": "^\\*\\*Reuse:\\*\\*\\s*None found\\.",
      "min": 3
    }
  },
  "must_match": [
    {
      "pattern": "\\A## 1\\. Approach",
      "why": "the reply is the plan alone: it starts at the Approach heading, with no preamble"
    },
    {
      "pattern": "^\\*\\*Requirements:\\*\\*(?=.*\\bREQ-005\\b)(?=.*\\bNFR-001\\b)",
      "why": "NFR-001 is a deadline on REQ-005's response: same phase"
    }
  ],
  "must_not_match": [
    {
      "pattern": "^### Phase \\d+: (Database|Data model|API|UI|Frontend|Backend)\\s*$",
      "why": "phases follow the flow, not the layers"
    },
    {
      "pattern": "^Blocked by",
      "why": "nothing is blocked"
    },
    {
      "pattern": "^```",
      "why": "a plan holds no code"
    },
    {
      "pattern": "^## 5\\. Revision History|^---$|^Note:",
      "why": "no Revision History, closing note, or rule in a chat reply"
    }
  ],
  "expectations": [
    "Each phase can merge on its own: no phase needs something that only a later phase builds.",
    "If NFR-003 (availability) is in its own later phase, the reply says why it can be met afterwards without changing behaviour.",
    "No requirement is added, reworded, or split."
  ],
  "manual": [
    "NFR-002 (accessibility) sits with REQ-015, or has a stated reason for a later phase.",
    "No phase name is a layer such as Database or UI."
  ]
