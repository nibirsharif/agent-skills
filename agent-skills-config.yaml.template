# Agent Skills Configuration Template
#
# Copy to ~/.agent-skills-config.yaml for a global default, or to
# <project-root>/.agent-skills-config.yaml to override it for one project.
# The project file wins when both exist.

# write-spec: directory where requirements are written.
# Each feature gets its own subdirectory:
#   <spec_output_dir>/<feature-name>/requirements.md
# An existing requirements.md is updated in place: IDs are kept and new ones continue its numbering.
# A relative path is resolved against the project root; absolute and ~ paths also work.
# Leave empty and write-spec asks where to save each time (a path, or "chat only").
# Example: docs/specs
spec_output_dir:

# write-plan: the largest number of requirement IDs (FR and NFR together) in one phase.
# A phase with more is split. Default 8.
plan_max_requirements_per_phase:

# write-plan: the largest estimated number of files a phase may add or change, tests included.
# A phase with more is split, however few requirements it has. Default 10.
plan_max_files_per_phase:

# write-tasks: the most files one task may add or change, tests included. Default 3.
tasks_max_files_per_task:

# write-tasks: the most tasks one phase may have. A phase that needs more is sent back to
# write-plan to be split, not squeezed. Default 12.
tasks_max_per_phase:

# build-phase: the most rework rounds (reopen the tasks behind a requirement that verify-spec does not
# find met, implement them again, verify again) before the run stops. Default 2.
build_max_rework_rounds:
